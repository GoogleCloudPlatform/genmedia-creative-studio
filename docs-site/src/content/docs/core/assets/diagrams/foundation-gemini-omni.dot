// Gemini Omni video generation, editing and multi-turn refinement workspace.
digraph foundation_gemini_omni {
  label = "Gemini Omni · video generation & editing workspace";
  rankdir = LR;
  ranksep = 0.55;
  nodesep = 0.38;

  user [label="User", class="terminal"];

  subgraph cluster_inputs {
    label = "Turn inputs";
    prompt [label="Text prompt\nmode · model"];
    format [label="Resolution (360p–4K)\naspect ratio · duration"];
    refs   [label="Reference media\nimage · video"];
  }

  subgraph cluster_omni {
    label = "Omni workspace (pages/omni.py · models/omni.py)";
    class = "accent";
    state  [label="Page state\nstate/omni_state.py", class="code"];
    build  [label="Validate mode & media\ninput parts + response_format", class="code"];
    client [label="interactions.create\ngemini-omni-1.2-flash", class="primary code"];
    parse  [label="Result parser\nfailed check · video payload", class="emphasis"];
  }

  subgraph cluster_storage {
    label = "Outputs & state";
    gcs       [label="gs://VIDEO_BUCKET\nomni_*.mp4", class="store code"];
    firestore [label="Firestore\nMediaItem", class="store code"];
    player    [label="Result player &\nmulti-turn chat", class="positive terminal"];
  }

  user -> {prompt format refs};
  {prompt format refs} -> state;
  state -> build;
  build -> client [label="input + response_format", class="primary"];
  client -> parse [label="model_output steps", class="primary"];
  parse -> gcs    [label="MP4 bitstream", class="async"];
  parse -> firestore [label="library metadata", class="async"];
  parse -> player [label="render turn", class="positive"];
  player -> state [label="follow-up turn\n(previous_interaction_id)", class="weak", constraint=false];
}
