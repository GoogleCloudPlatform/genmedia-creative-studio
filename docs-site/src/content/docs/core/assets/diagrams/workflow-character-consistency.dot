// Character Consistency 7-step workflow.
digraph workflow_character_consistency {
  label = "Character Consistency · 7-step identity preservation pipeline";
  rankdir = LR;
  ranksep = 0.5;
  nodesep = 0.35;

  refs [label="Reference photos &\nscene prompt", class="terminal"];

  subgraph cluster_profile {
    label = "Steps 1–3 · Gemini profiling";
    s1 [label="1. Facial composite\nprofile (Gemini)", class="agent-teal"];
    s2 [label="2. Natural language\ndescription", class="agent-teal"];
    s3 [label="3. Scene & negative\nprompt synthesis", class="agent-blue"];
  }

  subgraph cluster_image {
    label = "Steps 4–6 · Nano Banana & selection";
    class = "accent";
    s4 [label="4. Parallel candidates\nNano Banana (1:1)", class="primary"];
    s5 [label="5. Best likeness judge\nselect_best_image", class="decision"];
    s6 [label="6. 16:9 outpaint\nNano Banana reframe", class="emphasis"];
  }

  subgraph cluster_video {
    label = "Step 7 · Animation & storage";
    s7  [label="7. Veo I2V\ngenerate_video", class="agent-violet code"];
    db  [label="GCS & Firestore\nMediaItem", class="store code"];
    out [label="Consistent character\n16:9 video", class="positive terminal"];
  }

  refs -> s1 [class="primary"];
  s1 -> s2 -> s3 -> s4 [class="primary"];
  refs -> s4 [label="ref images", class="muted"];
  s4 -> s5 [label="4 candidates", class="primary"];
  refs -> s5 [label="compare likeness", class="muted"];
  s5 -> s6 [label="best candidate", class="positive"];
  s6 -> s7 [label="16:9 frame", class="primary"];
  s7 -> db [class="async"];
  s7 -> out [class="positive"];
}
