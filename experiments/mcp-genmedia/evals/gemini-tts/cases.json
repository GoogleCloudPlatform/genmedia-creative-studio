{
 "_doc": "gemini_audio_tts / list_gemini_voices eval cases. 'expect' keys: error (bool), advisories (list of substrings that must appear), no_advisories (bool), ext (saved file extension), min_seconds, judge (bool: send audio to the LLM listener), not_spoken (words that must not be heard; soft unless hard_judge), transcript_has (words that should be heard), speakers (int), result_has (substrings in tool text). 'group' tags let you run a subset. control: true inverts the judge checks (the case PASSES only if the listener catches the defect), proving the not_spoken check is not vacuous.",
 "cases": [
  {
   "id": "t38-clean-lite",
   "group": "38",
   "tool": "gemini_audio_tts",
   "args": {
    "text": "Wait... <short pause> did you hear that? <gasp> Someone's at the door.",
    "prompt": "whispered, nervous",
    "voice_name": "Kore"
   },
   "expect": {
    "no_advisories": true,
    "ext": ".wav",
    "min_seconds": 2,
    "judge": true,
    "not_spoken": [
     "short pause",
     "gasp",
     "whispered"
    ],
    "transcript_has": [
     "did you hear that",
     "door"
    ]
   }
  },
  {
   "id": "t38-clean-flash-library-voice",
   "group": "38",
   "tool": "gemini_audio_tts",
   "args": {
    "model_name": "gemini-3.8-flash-tts",
    "text": "Righto, the kettle's on. <chuckle> Come in and take a load off.",
    "prompt": "warm, relaxed",
    "voice_name": "en-au-training-6"
   },
   "expect": {
    "no_advisories": true,
    "ext": ".wav",
    "judge": true,
    "not_spoken": [
     "chuckle"
    ],
    "transcript_has": [
     "kettle"
    ]
   }
  },
  {
   "id": "t38-emphasis-disfluency",
   "group": "38",
   "tool": "gemini_audio_tts",
   "args": {
    "model_name": "gemini-3.8-flash-tts",
    "text": "So, uhm... it was a VERY long day. <sigh> Nobody listens anymore.",
    "prompt": "tired, flat",
    "voice_name": "Iapetus"
   },
   "expect": {
    "no_advisories": true,
    "judge": true,
    "not_spoken": [
     "sigh"
    ],
    "transcript_has": [
     "long day"
    ]
   }
  },
  {
   "id": "t38-legacy-square-tags",
   "group": "38-lint",
   "tool": "gemini_audio_tts",
   "args": {
    "text": "[sigh] I can't believe the build failed again. [whispering] Don't tell anyone."
   },
   "expect": {
    "advisories": [
     "[square] tags",
     "[whispering] -> style"
    ],
    "judge": true,
    "not_spoken": [
     "sigh"
    ]
   }
  },
  {
   "id": "t38-angle-whisper",
   "group": "38-lint",
