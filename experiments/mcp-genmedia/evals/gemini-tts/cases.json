   "args": {
    "text": "Joe: How's it going?\nJane: Not bad at all."
   },
   "expect": {
    "advisories": [
     "turns + speakers"
    ]
   }
  },
  {
   "id": "t38-long-style",
   "group": "38-lint",
   "tool": "gemini_audio_tts",
   "args": {
    "text": "Yes, massive vibes in the studio!",
    "voice_name": "Puck",
    "prompt": "# AUDIO PROFILE: Jaz R. The Morning Hype. THE SCENE: The London Studio. It is 10:00 PM in a glass-walled studio overlooking the moonlit London skyline, but inside it is blindingly bright. DIRECTOR'S NOTES Style: the vocal smile, high projection without shouting. Pace: bouncing. Accent: Brixton, London."
   },
   "expect": {
    "advisories": [
     "short styles"
    ]
   }
  },
  {
   "id": "t38-two-speaker",
   "group": "38",
   "tool": "gemini_audio_tts",
   "args": {
    "model_name": "gemini-3.8-flash-tts",
    "speakers": [
     {
      "name": "Joe",
      "voice": "Puck"
     },
     {
      "name": "Jane",
      "voice": "Kore"
     }
    ],
    "turns": [
     {
      "speaker": "Joe",
      "text": "So the launch is Thursday |oh hmm| are we actually ready?",
      "style": "brisk, a little anxious"
     },
     {
      "speaker": "Jane",
      "text": "Ready enough. The last blocker cleared this morning. <laugh>",
      "style": "relaxed, confident"
     }
    ]
   },
   "expect": {
    "no_advisories": true,
    "judge": true,
    "speakers": 2,
    "not_spoken": [
     "Joe",
     "Jane"
    ],
    "transcript_has": [
     "Thursday",
     "blocker"
    ]
   }
  },
  {
   "id": "t38-three-speakers-error",
